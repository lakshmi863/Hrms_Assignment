# ==================================
# SERVER CONFIGURATION
# ==================================
# The port your Express backend server will run on.
PORT=5000


# ==================================
# DATABASE CONFIGURATION (PostgreSQL)
# ==================================
# Use 'localhost' if the database is on the same machine.
DB_HOST=localhost

# The default port for PostgreSQL is 5432.
DB_PORT=5432

# The name of the database you created (e.g., 'hrms_db').
DB_NAME=hrms_db

# The username you created for your application to access the database.
DB_USER=lakshmi

# The password for the database user.
DB_PASS=lakshmi

# ==================================
# AUTHENTICATION & SECURITY
# ==================================
# A long, complex, and random secret key used to sign and verify JSON Web Tokens.
# DO NOT use a simple or guessable phrase.
# Generate a secure, random string for this value.
JWT_SECRET=mykey


# ==================================
# NODE ENVIRONMENT (Optional)
# ==================================
# Helps some libraries optimize their performance. Can be 'development' or 'production'.
NODE_ENV=development